{
    "name": "aw-watcher-vscode",
    "displayName": "aw-watcher-vscode (bc fork)",
    "description": "Fork of the ActivityWatch editor watcher: records the workspace when no file has focus, reports while the window is focused, and alerts when upstream has new commits.",
    "version": "0.5.1",
    "repository": {
        "type": "git",
        "url": "https://github.com/bcolloran/aw-watcher-vscode"
    },
    "publisher": "bcolloran",
    "author": "ActivityWatch Developers",
    "bugs": {
        "url": "https://github.com/bcolloran/aw-watcher-vscode/issues"
    },
    "engines": {
        "vscode": "^1.23.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "multi-root ready"
    ],
    "icon": "media/logo/logo.png",
    "activationEvents": [
        "*"
    ],
    "extensionKind": [
        "ui"
    ],
    "main": "./out/src/extension",
    "contributes": {
        "commands": [
            {
                "command": "awWatcherVscodeFork.reload",
                "title": "Reload ActivityWatch (fork)"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "aw-watcher-vscode extension configuration",
            "properties": {
                "aw-watcher-vscode.maxHeartbeatsPerSec": {
                    "type": "number",
                    "default": 1,
                    "description": "Controls the maximum number of hearbeats sent per second."
                },
                "aw-watcher-vscode.focusedHeartbeatIntervalSec": {
                    "type": "number",
                    "default": 10,
                    "description": "While the window is focused, send a heartbeat this often (in seconds) even without editor activity, so time in webviews, terminals and other non-text views is recorded. Keep it below the 20 second pulse time. 0 disables it."
                }
            }
        }
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "postinstall": "node ./node_modules/vscode/bin/install",
        "test": "npm run compile && node ./node_modules/vscode/bin/test",
        "test:mocha": "npm run compile && node ./node_modules/mocha/bin/mocha ./out/test/extension.test.js",
        "vscode:prepublish": "npm run compile && bash scripts/write-upstream-base.sh",
        "package": "npx --yes @vscode/vsce@2.32.0 package"
    },
    "devDependencies": {
        "@types/mocha": "^2.2.42",
        "@types/node": "^7.10.11",
        "mocha": "^8.2.1",
        "tslint": "^5.20.1",
        "typescript": "^4.1.3",
        "vscode": "^1.1.37"
    },
    "dependencies": {
        "axios": "^0.21.1"
    }
}
